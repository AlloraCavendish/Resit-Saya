# Purpose: Environment configuration template for Docker Compose deployment.
# Security: Change SECRET_KEY to a secure 32+ character random string before starting production containers.

SECRET_KEY=generate-a-secure-random-string-at-least-32-chars-long
DEV_MODE=False
COOKIE_SECURE=False
APP_TIMEZONE=Asia/Kuala_Lumpur
APP_VERSION=1.0.0
