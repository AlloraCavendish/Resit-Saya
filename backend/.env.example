# Purpose: Example environment variables configuration for Resit Saya.
# Security: Defines configuration parameters; never put real production secrets in this file.

# Application secret key (used for cryptographic tokens and session verification)
# In production, generate a secure key with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-very-secure-random-secret-key-32-bytes-minimum

# Database connection URL (SQLite for local dev, PostgreSQL for production)
DATABASE_URL=sqlite:///./resitsaya.db

# Storage directory for receipt attachments
UPLOAD_DIR=../uploads

# Maximum allowed upload size in megabytes
MAX_UPLOAD_MB=10

# Application business timezone for date partitioning and reports
APP_TIMEZONE=Asia/Kuala_Lumpur

# Soft-delete retention window in days before permanent deletion
RETENTION_DAYS=30

# Cookie secure flag (false for local http dev, true for production https)
COOKIE_SECURE=false

# Session cookie lifetime in days
SESSION_DAYS=7

# Development mode flag (if false, refuses to start with default SECRET_KEY)
DEV_MODE=true
