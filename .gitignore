# Purpose: Root Git ignore specification for Resit Saya.
# Security: Prevents sensitive local environments (.env), database files, and uploaded user documents from leaking into version control.

# Environment and secrets
.env
*.env.local

# Runtime file uploads
uploads/
/uploads/

# Database files
*.db
*.sqlite
*.sqlite3

# Python virtual environment and caches
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.pytest_cache/
.ruff_cache/

# Node & Frontend build
node_modules/
frontend/dist/
frontend/node_modules/
.eslintcache
.parcel-cache

# Operating System & IDEs
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
